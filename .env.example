# X API v2 Bearer Token. Keep the real value in .env, never commit it.
AI_MODEL_WATCH_X_BEARER_TOKEN=

# Separate multiple X queries with ||. X collection is disabled by default.
# AI_MODEL_WATCH_X_QUERIES=(OpenAI OR Anthropic OR Claude OR GPT) -is:retweet

# Optional local Korean translation through Ollama/llama.cpp/vLLM.
# AI_MODEL_WATCH_LLM=openai-compatible
# AI_MODEL_WATCH_LLM_ENDPOINT=http://127.0.0.1:11434
# AI_MODEL_WATCH_LLM_MODEL=your-local-model
# AI_MODEL_WATCH_TRANSLATION=true
# AI_MODEL_WATCH_TRANSLATION_LIMIT=100
# Optional translation model, separate from relevance/claim analysis.
# AI_MODEL_WATCH_TRANSLATION_MODEL=qwen3:14b
